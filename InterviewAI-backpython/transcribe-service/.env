APP_NAME=transcribe-service
APP_PORT=8002
APP_ENV=dev

WHISPER_MODEL=small
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_BEAM_SIZE=5
WHISPER_LANGUAGE=ru
WHISPER_VAD_FILTER=true

MAX_AUDIO_MB=20
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080