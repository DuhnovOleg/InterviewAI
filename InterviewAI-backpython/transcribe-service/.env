APP_NAME=transcribe-service
APP_PORT=8002
APP_ENV=dev

#TRANSCRIBE_ENGINE=vosk

#TRANSCRIBE_ENGINE=coqui
#COQUI_MODEL_PATH=models/coqui/model.tflite
#COQUI_SCORER_PATH=models/coqui/model.scorer

#TRANSCRIBE_ENGINE=nemo

#TRANSCRIBE_ENGINE=kaldi
#KALDI_DECODE_SCRIPT=scripts/kaldi_decode.bat

TRANSCRIBE_ENGINE=whisper

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_LANGUAGE=ru
WHISPER_VAD_FILTER=true

MAX_AUDIO_MB=20
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

VOSK_MODEL_PATH=models/vosk-model-small-ru-0.22

COQUI_MODEL_PATH=models/coqui/model.tflite
COQUI_SCORER_PATH=models/coqui/model.scorer

NEMO_MODEL_NAME_OR_PATH=nvidia/parakeet-tdt-0.6b-v2
NEMO_DEVICE=cpu

KALDI_DECODE_SCRIPT=scripts/kaldi_decode.bat